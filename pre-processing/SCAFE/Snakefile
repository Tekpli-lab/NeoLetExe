rule combine_samples:
        input:
                sample_list = expand(os.path.join(dataDir, "counts", "{sample}", "matrix"), sample = SAMPLE),
                sc_metadata = sc_metadata
        output:
                os.path.join(outDir, "seurat_object_unprocessed", "all_cells.rds")
        params:
                outDir = outDir,
                dataDir = dataDir,
                SAMPLE = SAMPLE,
                script = os.path.join(scriptsDir, "combine_samples.R")
        singularity: config["Seurat_container"]
        shell:
                """
                Rscript {params.script} \
                    --outDir {params.outDir} \
                    --dataDir {params.dataDir} \
                    --sample_names_list "{params.SAMPLE}" \
                    --sc_metadata {input.sc_metadata}
                """


