        neg_bed_file = lambda wildcards: [] if '_no_' not in wildcards.TF else [os.path.join(outDir, "contrasts", "all_cells_model", wildcards.contrast, "TF_analysis", "all_TFBS_{proximity}", "TF_CRE_bed", f"{tf}.bed") for tf in wildcards.TF.split('_no_', 1)[1].split('_')] 
    output:
        pdf = os.path.join(outDir, "contrasts", "all_cells_model", "{contrast}", "TF_analysis", "all_TFBS_{proximity}", "TF_boxplots", "{patient_split}", "{patient_split}__{main_id}__{TF}.pdf"),
        rds = os.path.join(outDir, "contrasts", "all_cells_model", "{contrast}", "TF_analysis", "all_TFBS_{proximity}", "TF_boxplots", "{patient_split}", "{patient_split}__{main_id}__{TF}.rds")
    params:
        script = os.path.join(scriptsDir, "simple_set_ratio_boxplot.R")
    singularity: config["Seurat_container"]
    shell:
        """
        DIR="$(dirname {output.pdf})"
        Rscript {params.script} --seurat_object {input.seurat_object} --output_dir $DIR --pos_bed_files "{input.pos_bed_file}" --neg_bed_files "{input.neg_bed_file}" --main_id {wildcards.main_id} --tf_name {wildcards.TF} --patient_split {wildcards.patient_split}
        """

