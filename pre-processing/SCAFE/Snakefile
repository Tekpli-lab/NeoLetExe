rule Upset_stacked_bar_test:
    input:
        Intervene_combinations_fore = os.path.join(outDir, "contrasts", "all_cells_model", "{contrast_fore}", "TF_analysis", "{ub_mode}_TFBS_{proximity}", "Upset_plots", "{TF}", "Intervene_upset_combinations.txt"),
        diff_cre_bed_fore = os.path.join(outDir, "contrasts", "all_cells_model", "{contrast_fore}", "{proximity}_contig_tests", "diff_cre_fisher__foreground.bed"),
        Intervene_combinations_back = os.path.join(outDir, "contrasts", "all_cells_model", "{contrast_back}", "TF_analysis", "{ub_mode}_TFBS_{proximity}", "Upset_plots", "{TF}", "Intervene_upset_combinations.txt"),
        diff_cre_bed_back = os.path.join(outDir, "contrasts", "all_cells_model", "{contrast_back}", "{proximity}_contig_tests", "diff_cre_fisher__foreground.bed")
    output:
        os.path.join(outDir, "contrasts", "all_cells_model", "{contrast_fore}", "TF_analysis", "Upset_Stacked_bar_{ub_mode}__{proximity}", "{contrast_fore}__vs__{contrast_back}__{TF}__{ub_mode}__{proximity}.pdf"),
        os.path.join(outDir, "results", "Upset_Stacked_bar_{ub_mode}__{proximity}", "{contrast_fore}__vs__{contrast_back}__{TF}__{ub_mode}__{proximity}.pdf")
    params:
        script = os.path.join(scriptsDir, "Upset_proportion_test.R")
    singularity: config["Seurat_container"]
    shell:
        """
        Rscript {params.script} \
                --output {output[0]} \
                --Intervene_upset_combinations {input.Intervene_combinations_fore} \
                --diff_cre {input.diff_cre_bed_fore} \
                --Intervene_upset_combinations2 {input.Intervene_combinations_back} \
                --diff_cre2 {input.diff_cre_bed_back} \
                --label1 {wildcards.contrast_fore} \
                --label2 {wildcards.contrast_back}
        cp {output[0]} {output[1]}
        """