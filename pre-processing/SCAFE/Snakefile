def get_wildcards_from_metadata(var, file = sc_metadata):
    with open(file, 'r') as f:
        # Read the header to find the index of the variable
        header = [h.strip().strip('"') for h in f.readline().strip().split(',')]
        if var not in header:
            raise ValueError(f"Variable '{var}' not found in header")
        var_index = header.index(var)

        # Read the file and extract unique values for the given variable
        wildcard_set = set()
        for line in f:
            fields = [field.strip('"') for field in line.strip().split(',')]
            if len(fields) > var_index:
                wildcard_set.add(fields[var_index])

    # Convert the set to a sorted list
    wildcard_list = sorted(wildcard_set)
    return wildcard_list



